# Shared editor settings (Android Studio / IntelliJ read this file).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Kotlin official code style (also set by kotlin.code.style=official in gradle.properties)
max_line_length = 120
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

[*.{xml,yml,yaml,json,toml}]
indent_size = 2

[*.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{gradlew,*.sh,update-binary,updater-script}]
end_of_line = lf
